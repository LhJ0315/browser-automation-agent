# Local secrets for browser-automation-agent (DO NOT COMMIT)
# Copy to .env and fill in, or set the same names as environment variables.
#
#   copy .env.example .env

DOUBAO_API_KEY=your-ark-api-key-here
DOUBAO_MODEL=ep-xxxxxxxx
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Optional safety defaults (comma-separated host allowlist)
# BROWSER_ALLOWED_HOSTS=example.com,www.example.com,example.org

# P0 API / queue
# Prefer 127.0.0.1 (not localhost) — on Windows, localhost can hit ::1 and hang.
# If WSL Redis PONG works but Windows still gets Error 10061, run:
#   .\scripts\start-redis-wsl.ps1
# and if it prints a WSL IP fallback, set REDIS_URL to redis://<that-ip>:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
RQ_QUEUE=browser_tasks
MAX_TASK_SECONDS=300
MAX_BROWSER_WORKERS=1
# RUNS_ROOT=
# DATA_ROOT=
API_HOST=127.0.0.1
API_PORT=8000

# --- P1: API Key 鉴权 ---
# 留空 = 关闭鉴权（本地演示）；逗号分隔 = 开启，/api/v1/* 需 Authorization: Bearer <key>
# /health 始终匿名。
# API_KEYS=dev-secret

# --- P1: Postgres 任务/模板库 ---
# TASK_STORE=file（默认，本地 JSON）或 postgres
# TEMPLATE_STORE=file（默认，本地 JSON）或 postgres
# DATABASE_URL=postgresql+psycopg://browser:browser@127.0.0.1:5432/browser_agent

# --- P1: MinIO/S3 产物存储 ---
# ARTIFACT_STORE=local（默认，本地 runs/）或 s3
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=browser-runs
# S3_REGION=us-east-1

# --- Webhook 通知（任务终态回调） ---
# WEBHOOK_URL=https://example.com/hooks/browser-agent   # 逗号分隔支持多个
# WEBHOOK_SECRET=your-hmac-secret                        # 可选；配置后签名头 X-Webhook-Signature: sha256=<hex>
# 任务创建时也可在请求体传 webhook_url 覆盖全局配置。

# --- 多租户 / 权限（需 Postgres） ---
# 配置 DATABASE_URL 后启用：用户体系（登录签发 JWT）、API Key 表、RBAC（admin/user/read_only）、
# 任务与模板按 owner 隔离（普通用户仅见自己创建的；admin/静态 key 见全部）。
# SECRET_KEY 用于 JWT 签名（生产必改为 32+ 字节随机串；默认 dev 密钥仅限本地）。
# SECRET_KEY=change-me-to-a-long-random-string
# JWT_EXPIRES_MINUTES=1440
# 引导命令：
#   python -m scripts.auth_cli bootstrap-admin --username admin --password '...'
#   python -m scripts.auth_cli add-user --username alice --password '...' --role user
#   python -m scripts.auth_cli add-key --username alice --name "laptop"

# --- worker 自动扩缩（python -m worker.autoscale） ---
# 按队列深度动态增减 worker 进程：深度 0 保持 WORKER_MIN，超过后按 SCALE_UP_THRESHOLD
# 个任务/worker 扩到 WORKER_MAX。缩容仅停 RQ 状态为 idle 的 worker（不会打断运行中任务）。
# WORKER_MIN=1
# WORKER_MAX=3
# SCALE_UP_THRESHOLD=1
# AUTOSCALE_POLL_SECONDS=5
